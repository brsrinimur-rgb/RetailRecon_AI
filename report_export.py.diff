+            "Total Difference": round(d365_amt - pos_amt, 2),
+            "D365 Tender": d_tender,
+            "POS Tender": p_tender,
+            "POS Date": p_row.get("POS Date", pd.NaT),
+            "Posting Date": p_row.get("Posting Date", pd.NaT),
+            "Terminal ID": p_row.get("Terminal ID", ""),
+            "Commission": float(p_row.get("Commission", 0) or 0),
+            "VAT": float(p_row.get("VAT", 0) or 0),
+            "Net Amount": float(p_row.get("Net Amount", 0) or 0),
+            "Source": p_row.get("Source File", ""),
+            "Status": "Payment Method Mismatch",
+            "Remarks": (
+                f"Auth Code and Amount (SAR {pos_amt:,.2f}) match exactly between D365 (posted as "
+                f"{d_tender}) and POS/provider (recorded as {p_tender}) -- this is not a missing "
+                f"transaction and not a date issue. Confirm the correct payment method with the "
+                f"provider/bank and correct the tagging at source."
